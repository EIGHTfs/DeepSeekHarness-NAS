#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/deepseek-harness.log"
PID_FILE="${TRIM_PKGVAR}/deepseek-harness.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

export PATH="${APP_DIR}/bin:$PATH"
export HOME="${APP_DIR}"

# 使用单一 Node 进程统一调度器 runner.js
SERVICE_COMMAND="${APP_DIR}/bin/node ${APP_DIR}/bin/runner.js"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
SVC_CWD="${TRIM_PKGVAR}"
SVC_WAIT_TIMEOUT=10

service_postinst() {
    mkdir -p "${TRIM_PKGVAR}/config" 2>/dev/null || true

    # 创建并打通与飞牛文件管理直接互通的应用工作区目录
    SHARE_WORKSPACE="/vol1/@appshare/DeepSeekHarness"
    if [ -d "/vol1" ]; then
        mkdir -p "${SHARE_WORKSPACE}/workspace" "${SHARE_WORKSPACE}/data" 2>/dev/null || true
        # 只放开用户需要经飞牛文件管理器读写的普通目录，绝不递归 777 整个
        # SHARE_WORKSPACE——否则会连 .dsh/.credentials.yaml 一起变成 777，
        # 触发 DSH "readable beyond its owner" 拒绝启动，并造成守护无限重启。
        chmod -R 777 "${SHARE_WORKSPACE}/workspace" "${SHARE_WORKSPACE}/data" 2>/dev/null || true
        # 收紧 DSH 主目录与凭据目录，避免历史版本遗留的 777
        chmod 700 "${SHARE_WORKSPACE}/.dsh" 2>/dev/null || true

        # 将 @appdata/data 软链接指向 @appshare/DeepSeekHarness
        if [ -d "${TRIM_PKGVAR}/data" ] && [ ! -L "${TRIM_PKGVAR}/data" ]; then
            cp -a "${TRIM_PKGVAR}/data/." "${SHARE_WORKSPACE}/data/" 2>/dev/null || true
            rm -rf "${TRIM_PKGVAR}/data"
        fi
        ln -sf "${SHARE_WORKSPACE}" "${TRIM_PKGVAR}/data" 2>/dev/null || true
    fi
}

service_postupgrade() {
    service_postinst
}

service_preuninst() {
    pkill -9 -f "${APP_DIR}/bin/runner.js" 2>/dev/null || true
    pkill -9 -f "${APP_DIR}/bin/proxy.js" 2>/dev/null || true
    rm -f "${PID_FILE}" 2>/dev/null || true
}

service_poststop() {
    service_preuninst
}
